# Main Database
DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_main

# Auth Service (if using separate database)
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_auth
AUTH_PORT=3002

# Booking Service
BOOKING_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_booking
BOOKING_PORT=3003

# Payment Service
PAYMENT_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_payment
PAYMENT_PORT=3004

# Ticket Service
TICKET_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_ticket
TICKET_PORT=3005

# Catalog Service (Mountains/Routes)
CATALOG_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_catalog
CATALOG_PORT=3006

# Weather Service
WEATHER_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_weather
WEATHER_PORT=3007

# Quota Service
QUOTA_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_quota
QUOTA_PORT=3008

# Admin Service
ADMIN_DATABASE_URL=postgresql://user:password@localhost:5432/pesagi_admin
ADMIN_PORT=3009

# Gateway
GATEWAY_PORT=3000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Service URLs (for gateway routing)
AUTH_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
TICKET_SERVICE_URL=http://localhost:3005
CATALOG_SERVICE_URL=http://localhost:3006
WEATHER_SERVICE_URL=http://localhost:3007
QUOTA_SERVICE_URL=http://localhost:3008
ADMIN_SERVICE_URL=http://localhost:3009
